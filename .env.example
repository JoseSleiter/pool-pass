# Supabase (local values come from `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin allowlist — comma-separated emails that may access /admin.
# A logged-in Supabase user is NOT an admin unless their email is listed here.
ADMIN_EMAILS=dueno@tuclub.com,gerente@tuclub.com,recepcion@tuclub.com

# Mercantil C2P
MERCANTIL_BASE_URL=https://apimbu.mercantilbanco.com/mercantil-banco/prod
MERCANTIL_CLIENT_ID=
MERCANTIL_MERCHANT_ID=
MERCANTIL_INTEGRATOR_ID=
MERCANTIL_TERMINAL_ID=1
MERCANTIL_SECRET_KEY=
# 1 = fake the bank call (dev/e2e). OTP 999999 declines, anything else approves.
MERCANTIL_MOCK=0

# BCV rate — official rate with multi-source fallback (tried in order).
# 1) dolarapi "oficial" mirror:
BCV_RATE_URL=https://ve.dolarapi.com/v1/dolares/oficial
# 2) pydolarve BCV monitor (fallback, optional — has a sensible default):
# BCV_PYDOLARVE_URL=https://pydolarve.org/api/v1/dollar?page=bcv&monitor=usd
# 3) direct BCV site scrape (last resort, optional — has a sensible default):
# BCV_SITE_URL=https://www.bcv.org.ve/

# Email (Gmail SMTP)
# Requires a Gmail account with 2-Step Verification ON, then an App Password:
#   Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
# Optional: defaults to SMTP_USER. Format "Nombre <tucorreo@gmail.com>" also works.
VOUCHER_FROM_EMAIL=

# Public site URL — used to build the QR link inside the voucher email.
# In production set this to your deployed URL (e.g. https://tu-app.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
